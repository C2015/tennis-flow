<view wx:if="{{match}}" class="detail-page safe-bottom">
  <view class="match-hero">
    <text class="kicker">{{match.tour}} · {{match.level}} · {{match.roundText}}</text>
    <text class="tournament">{{match.tournament}}</text>
    <view class="status-line"><view></view><text>{{match.statusText}}</text></view>
    <view class="venue-line">
      <view class="venue-mark"><view></view></view>
      <view class="venue-copy">
        <text>{{match.hasExactCourt ? '比赛场地' : '赛事地点'}}</text>
        <text>{{match.courtText}}</text>
      </view>
    </view>

    <view class="versus">
      <view class="competitor left">
        <text class="country">{{match.player1Country || '—'}} · {{match.player1Rank ? '世界 #' + match.player1Rank : '暂无排名'}}</text>
        <text class="name {{match.winner === 1 ? 'winner' : ''}}">{{match.player1Primary}}</text>
        <text wx:if="{{match.player1Secondary}}" class="secondary">{{match.player1Secondary}}</text>
      </view>
      <view class="score">{{match.score || 'VS'}}</view>
      <view class="competitor right">
        <text class="country">{{match.player2Country || '—'}} · {{match.player2Rank ? '世界 #' + match.player2Rank : '暂无排名'}}</text>
        <text class="name {{match.winner === 2 ? 'winner' : ''}}">{{match.player2Primary}}</text>
        <text wx:if="{{match.player2Secondary}}" class="secondary">{{match.player2Secondary}}</text>
      </view>
    </view>
  </view>

  <view class="detail-body">
    <view wx:if="{{broadcasts.length}}" class="broadcast-panel">
      <view class="broadcast-heading">
        <view><text class="live-dot"></text><text>已核实直播入口</text></view>
        <text>具体场次</text>
      </view>
      <button wx:for="{{broadcasts}}" wx:key="platform" class="broadcast-button"
        data-index="{{index}}" bindtap="openBroadcast">
        <text class="play-icon">{{item.canDirectOpen ? '↗' : '⧉'}}</text>
        <view><text>{{item.label}}</text><text>{{item.hint}}</text></view>
        <text class="broadcast-arrow">›</text>
      </button>
    </view>

    <button wx:if="{{match.tournamentId}}" class="draw-entry" bindtap="openDraw">
      <view class="draw-glyph">
        <view></view><view></view><view></view>
      </view>
      <view class="draw-entry-copy">
        <text>赛事签表</text>
        <text>对阵与晋级</text>
      </view>
      <text class="draw-entry-arrow">›</text>
    </button>

    <view class="facts">
      <view wx:for="{{facts}}" wx:key="label" class="fact">
        <text>{{item.label}}</text><text class="fact-value">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{match.setScores.length}}" class="section">
      <view class="section-heading"><text>每盘比分</text><text class="section-note">球员 1 / 球员 2</text></view>
      <view wx:for="{{match.setScores}}" wx:key="setIndex" class="stat-row">
        <text class="stat-value {{item.p1Won ? 'accent' : ''}}">{{item.p1}}</text>
        <text>第 {{index + 1}} 盘</text>
        <text class="stat-value {{item.p2Won ? 'accent' : ''}}">{{item.p2}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-heading"><text>比赛技术统计</text><text wx:if="{{stats.length}}" class="section-note">左侧 / 右侧球员</text></view>
      <view wx:if="{{stats.length}}">
        <view wx:for="{{stats}}" wx:key="label" class="stat-row">
          <text class="stat-value">{{item.left}}</text><text>{{item.label}}</text><text class="stat-value">{{item.right}}</text>
        </view>
      </view>
      <view wx:else class="no-stats">
        {{match.status === 'finished' ? '数据源暂未提供本场技术统计' : '比赛结束后，如数据源提供则在这里显示'}}
      </view>
      <button wx:if="{{statsSource}}" class="stats-source" bindtap="copyStatsSource">{{statsSource}} · 复制官方链接</button>
    </view>

    <view class="source-note">
      <text>开赛时间、场地、排名和技术统计仅在数据源提供时展示。</text>
      <button wx:if="{{match.sourceUrl}}" bindtap="copySource">复制 ESPN 数据来源</button>
    </view>
  </view>
</view>
