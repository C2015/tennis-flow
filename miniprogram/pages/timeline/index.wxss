.page-shell { position: relative; min-height: 100vh; overflow: hidden; background: #071b16; }
.court-lines { position: absolute; inset: 0 28rpx auto; height: 520rpx; opacity: .06; border: 2rpx solid #f2f1e9; border-top: 0; pointer-events: none; }
.court-lines::before { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 2rpx; background: #f2f1e9; }
.court-lines::after { content: ""; position: absolute; left: 0; right: 0; top: 48%; height: 2rpx; background: #f2f1e9; }

.hero { position: relative; height: 430rpx; padding: 34rpx 36rpx 0; box-sizing: border-box; }
.brand-row { display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; font-size: 34rpx; font-weight: 800; letter-spacing: 3rpx; }
.brand-ball { width: 34rpx; height: 34rpx; margin-right: 15rpx; border-radius: 50%; background: #d9ff43; box-shadow: 0 0 34rpx rgba(217,255,67,.28); }
.timezone { color: #82938b; font-size: 20rpx; letter-spacing: 1rpx; }
.eyebrow { display: flex; align-items: center; margin-top: 70rpx; color: #d9ff43; font-size: 20rpx; letter-spacing: 4rpx; }
.eyebrow view { width: 38rpx; height: 2rpx; margin-right: 14rpx; background: currentColor; }
.hero-title { position: relative; z-index: 2; margin-top: 22rpx; font-size: 68rpx; font-weight: 900; line-height: 1.03; letter-spacing: -5rpx; }
.hero-title text { display: block; color: #d9ff43; }
.hero-orbit { position: absolute; right: -76rpx; top: 108rpx; width: 260rpx; height: 260rpx; border: 2rpx solid rgba(217,255,67,.14); border-radius: 50%; }
.hero-orbit::before { content: ""; position: absolute; inset: 48rpx; border: 2rpx solid rgba(217,255,67,.11); border-radius: 50%; }
.hero-orbit view { position: absolute; inset: 112rpx; border-radius: 50%; background: #d9ff43; box-shadow: 0 0 70rpx rgba(217,255,67,.3); }

.scoreboard { position: relative; min-height: 700rpx; padding: 38rpx 28rpx 48rpx; color: #071b16; background: #f2f1e9; border-radius: 48rpx 48rpx 0 0; box-sizing: border-box; }
.date-heading { display: flex; align-items: flex-end; justify-content: space-between; padding: 0 8rpx 32rpx; }
.date-year { color: #858d88; font-family: "DIN Alternate", sans-serif; font-size: 24rpx; }
.date-title { margin-top: 4rpx; font-size: 54rpx; font-weight: 900; line-height: 1; letter-spacing: -3rpx; }
.date-subtitle { display: block; margin-top: 10rpx; color: #717c76; font-size: 22rpx; }
.today-button { width: auto; margin: 0; padding: 2rpx 24rpx; color: #31423a; background: transparent; border: 2rpx solid #c4c8c0; border-radius: 999rpx; font-size: 22rpx; line-height: 56rpx; }

.date-navigator { display: flex; align-items: stretch; height: 132rpx; border-top: 2rpx solid #d1d2ca; border-bottom: 2rpx solid #d1d2ca; }
.date-arrow { flex: 0 0 42rpx; width: 42rpx; margin: 0; padding: 0; color: #59665f; background: transparent; font-size: 30rpx; line-height: 132rpx; }
.date-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.date-strip { display: inline-flex; min-width: 100%; height: 132rpx; }
.date-tab { position: relative; flex: 0 0 104rpx; width: 104rpx; height: 132rpx; margin: 0; padding: 25rpx 0 0; color: #737b77; background: transparent; border-left: 2rpx solid #d1d2ca; border-radius: 0; font-size: 19rpx; line-height: 1.2; box-sizing: border-box; }
.date-tab:last-child { border-right: 2rpx solid #d1d2ca; }
.date-tab .date-number { display: block; margin-top: 11rpx; color: #071b16; font-family: "DIN Alternate", sans-serif; font-size: 35rpx; font-weight: 700; line-height: 1; }
.date-tab.active { color: #aab6b0; background: #071b16; }
.date-tab.active .date-number { color: #d9ff43; }
.today-dot { position: absolute; bottom: 12rpx; left: 50%; width: 7rpx; height: 7rpx; margin-left: -3rpx; border-radius: 50%; background: #d9ff43; }

.toolbar { display: flex; align-items: center; padding: 34rpx 0 20rpx; }
.filters { flex: 1; min-width: 0; white-space: nowrap; }
.filter-row { display: inline-flex; padding-right: 12rpx; }
.filter { width: auto; min-width: 0; margin: 0 10rpx 0 0; padding: 0 24rpx; color: #53615a; background: transparent; border: 2rpx solid #c8cbc3; border-radius: 999rpx; font-size: 22rpx; line-height: 56rpx; }
.filter.active { color: #f2f1e9; background: #0c2d24; border-color: #0c2d24; }
.match-count { flex: 0 0 auto; color: #727d77; font-family: "DIN Alternate", sans-serif; font-size: 22rpx; }
.search-box { display: flex; align-items: center; height: 78rpx; margin-bottom: 28rpx; padding: 0 22rpx; color: #69746e; border: 2rpx solid #c8cbc3; border-radius: 22rpx; box-sizing: border-box; }
.search-icon { margin-right: 15rpx; font-size: 34rpx; transform: rotate(-18deg); }
.search-box input { flex: 1; color: #071b16; font-size: 25rpx; }
.clear-button { width: 52rpx; height: 52rpx; margin: 0; padding: 0; color: #6f7974; background: transparent; font-size: 38rpx; line-height: 48rpx; }

.timeline { position: relative; }
.timeline-line { position: absolute; left: 29rpx; top: 40rpx; bottom: 0; width: 2rpx; background: #ced0c8; }
.tournament-group { position: relative; display: block; margin-bottom: 54rpx; }
.tournament-header { display: flex; align-items: center; min-height: 82rpx; }
.tour-mark { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-right: 20rpx; background: #0c2d24; border: 14rpx solid #f2f1e9; border-radius: 50%; box-shadow: 0 0 0 2rpx #cfd1ca; box-sizing: content-box; }
.tour-mark view { width: 13rpx; height: 13rpx; border-radius: 50%; background: #d9ff43; }
.tournament-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.tour-level { color: #778079; font-family: "DIN Alternate", sans-serif; font-size: 18rpx; letter-spacing: 2rpx; }
.tour-name { margin-top: 5rpx; overflow: hidden; font-size: 28rpx; font-weight: 800; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.tour-meta { margin-top: 4rpx; color: #7a847e; font-size: 19rpx; }
.match-list { margin-left: 78rpx; border-top: 2rpx solid #d5d6cf; }
.match-card { display: flex; align-items: center; width: 100%; min-height: 126rpx; margin: 0; padding: 22rpx 2rpx; color: #071b16; background: transparent; border-bottom: 2rpx solid #d5d6cf; border-radius: 0; text-align: left; line-height: 1; box-sizing: border-box; }
.match-time { flex: 0 0 92rpx; }
.match-time .time-value { display: block; font-family: "DIN Alternate", sans-serif; font-size: 31rpx; font-weight: 700; }
.match-time text { display: block; max-width: 88rpx; margin-top: 9rpx; overflow: hidden; color: #77817c; font-size: 17rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.players { flex: 1; min-width: 0; }
.player-row { display: flex; align-items: center; min-height: 48rpx; }
.country { flex: 0 0 48rpx; color: #78827d; font-family: "DIN Alternate", sans-serif; font-size: 16rpx; }
.player-name { flex: 1; min-width: 0; font-size: 24rpx; }
.player-name > text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-name .player-secondary { margin-top: 5rpx; color: #818984; font-family: "DIN Alternate", sans-serif; font-size: 15rpx; }
.player-name.winner { font-weight: 900; }
.rank { flex: 0 0 48rpx; color: #858d88; font-family: "DIN Alternate", sans-serif; font-size: 17rpx; text-align: right; }
.sets { display: flex; flex: 0 0 auto; margin-left: 10rpx; }
.set-score { width: 38rpx; margin-left: 5rpx; overflow: hidden; background: #dedfd7; border-radius: 7rpx; }
.set-score text { display: flex; align-items: center; justify-content: center; height: 44rpx; font-family: "DIN Alternate", sans-serif; font-size: 20rpx; }
.set-score .won { color: #f2f1e9; background: #0c2d24; }
.status-pill { flex: 0 0 auto; margin-left: 10rpx; padding: 12rpx 15rpx; color: #627069; border: 2rpx solid #c6cac1; border-radius: 999rpx; font-size: 18rpx; }
.chevron { margin-left: 8rpx; color: #87908b; font-size: 34rpx; }

.loading { display: flex; justify-content: center; padding: 120rpx 0 160rpx; }
.loading view { width: 13rpx; height: 13rpx; margin: 0 7rpx; border-radius: 50%; background: #0c2d24; animation: pulse .75s infinite alternate; }
.loading view:nth-child(2) { animation-delay: .16s; }
.loading view:nth-child(3) { animation-delay: .32s; }
@keyframes pulse { to { opacity: .2; transform: translateY(-10rpx); } }
.state-panel { display: flex; align-items: center; flex-direction: column; padding: 110rpx 30rpx 150rpx; text-align: center; }
.state-ball { width: 76rpx; height: 76rpx; border-radius: 50%; background: #d9ff43; box-shadow: inset 0 0 0 2rpx #bfd738; }
.error-ball { background: #ff806b; box-shadow: none; }
.state-title { margin-top: 28rpx; font-size: 30rpx; font-weight: 800; }
.state-copy { margin-top: 12rpx; color: #748079; font-size: 22rpx; line-height: 1.6; }
.retry-button { width: auto; margin-top: 28rpx; padding: 0 30rpx; color: #f2f1e9; background: #0c2d24; border-radius: 999rpx; font-size: 22rpx; line-height: 64rpx; }
.data-status { display: flex; align-items: center; justify-content: center; margin-top: 36rpx; color: #7c8781; font-size: 19rpx; }
.data-status view { width: 10rpx; height: 10rpx; margin-right: 10rpx; border-radius: 50%; background: #8aaa24; }
.project-note { display: block; margin-top: 16rpx; color: #929993; font-size: 18rpx; text-align: center; }
