<view class="page-shell safe-bottom">
  <view class="court-lines"></view>

  <view class="hero">
    <view class="brand-row">
      <view class="brand"><view class="brand-ball"></view><text>球序</text></view>
      <text class="timezone">UTC+8 · 北京时间</text>
    </view>
    <view class="eyebrow"><view></view><text>按比赛时间自然展开</text></view>
    <view class="hero-title">今天，<text>谁在场上？</text></view>
    <view class="hero-orbit"><view></view></view>
  </view>

  <view class="scoreboard">
    <view class="date-heading">
      <view>
        <text class="date-year">{{selectedMeta.year}}</text>
        <view class="date-title">{{selectedMeta.month}}月{{selectedMeta.day}}日</view>
        <text class="date-subtitle">{{selectedMeta.weekday}} · {{selectedMeta.relative}}</text>
      </view>
      <button class="today-button" bindtap="returnToday">回到今天</button>
    </view>

    <view class="date-navigator">
      <button class="date-arrow" data-amount="-5" bindtap="shiftDates">←</button>
      <scroll-view class="date-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="date-strip">
          <button wx:for="{{dateStrip}}" wx:key="iso"
            class="date-tab {{item.iso === selectedDate ? 'active' : ''}}"
            data-date="{{item.iso}}" bindtap="selectDate">
            <text>{{item.weekday}}</text>
            <text class="date-number">{{item.day < 10 ? '0' + item.day : item.day}}</text>
            <view wx:if="{{item.isToday}}" class="today-dot"></view>
          </button>
        </view>
      </scroll-view>
      <button class="date-arrow" data-amount="5" bindtap="shiftDates">→</button>
    </view>

    <view class="toolbar">
      <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filter-row">
          <button wx:for="{{filters}}" wx:key="value"
            class="filter {{item.value === currentTour ? 'active' : ''}}"
            data-value="{{item.value}}" bindtap="selectTour">{{item.label}}</button>
        </view>
      </scroll-view>
      <text class="match-count">{{matchCount}} 场</text>
    </view>

    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input value="{{query}}" placeholder="搜索球员或赛事" confirm-type="search" bindinput="handleSearchInput" />
      <button wx:if="{{query}}" class="clear-button" bindtap="clearSearch">×</button>
    </view>

    <view wx:if="{{loading}}" class="loading" aria-label="数据加载中">
      <view></view><view></view><view></view>
    </view>

    <view wx:elif="{{error}}" class="state-panel">
      <view class="state-ball error-ball"></view>
      <text class="state-title">暂时没有接到比赛数据</text>
      <text class="state-copy">{{error}}</text>
      <button class="retry-button" bindtap="retry">重新加载</button>
    </view>

    <view wx:elif="{{!groups.length}}" class="state-panel">
      <view class="state-ball"></view>
      <text class="state-title">这一天暂时没有比赛</text>
      <text class="state-copy">试试相邻日期，或清除当前筛选。</text>
    </view>

    <view wx:else class="timeline">
      <view class="timeline-line"></view>
      <view wx:for="{{groups}}" wx:key="id" wx:for-index="groupIndex" class="tournament-group">
        <view class="tournament-header">
          <view class="tour-mark"><view></view></view>
          <view class="tournament-copy">
            <text class="tour-level">{{item.tour}} · {{item.level}}</text>
            <text class="tour-name">{{item.name}}</text>
            <text wx:if="{{item.meta}}" class="tour-meta">{{item.meta}}</text>
          </view>
        </view>

        <view class="match-list">
          <button wx:for="{{item.matches}}" wx:key="id" wx:for-item="match" wx:for-index="matchIndex"
            class="match-card" data-group="{{groupIndex}}" data-match="{{matchIndex}}" bindtap="openMatch">
            <view class="match-time">
              <text class="time-value">{{match.timeText}}</text>
              <text>{{match.status === 'finished' ? match.statusText : match.roundText}}</text>
            </view>
            <view class="players">
              <view class="player-row">
                <text class="country">{{match.player1Country || '—'}}</text>
                <view class="player-name {{match.winner === 1 ? 'winner' : ''}}">
                  <text>{{match.player1Primary}}</text><text wx:if="{{match.player1Secondary}}" class="player-secondary">{{match.player1Secondary}}</text>
                </view>
                <text class="rank">{{match.player1RankText}}</text>
              </view>
              <view class="player-row">
                <text class="country">{{match.player2Country || '—'}}</text>
                <view class="player-name {{match.winner === 2 ? 'winner' : ''}}">
                  <text>{{match.player2Primary}}</text><text wx:if="{{match.player2Secondary}}" class="player-secondary">{{match.player2Secondary}}</text>
                </view>
                <text class="rank">{{match.player2RankText}}</text>
              </view>
            </view>
            <view wx:if="{{match.status === 'finished'}}" class="sets">
              <view wx:for="{{match.setScores}}" wx:key="setIndex" wx:for-item="set" class="set-score">
                <text class="{{set.p1Won ? 'won' : ''}}">{{set.p1}}</text>
                <text class="{{set.p2Won ? 'won' : ''}}">{{set.p2}}</text>
              </view>
            </view>
            <text wx:else class="status-pill">{{match.statusText}}</text>
            <text class="chevron">›</text>
          </button>
        </view>
      </view>
    </view>

    <view class="data-status"><view></view><text>{{syncText}}</text></view>
    <text class="project-note">非商业网球数据项目 · 比赛时间可能因现场安排调整</text>
  </view>
</view>
